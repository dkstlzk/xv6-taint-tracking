From: Anshika <anshikabvbvpn0822@gmail.com>
Date: Mon, 26 Oct 2026 22:31:36 +0530
Subject: [PATCH 18/47] [Member C] C-05: Implement real sys_marktaint with path
 validation and inode persistence

---
 kernel/sysfile.c | 26 ++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/kernel/sysfile.c b/kernel/sysfile.c
index f7143b0..c5f8227 100644
--- a/kernel/sysfile.c
+++ b/kernel/sysfile.c
@@ -529,10 +529,32 @@ sys_pipe(void)
   return 0;
 }
 
-// sys_marktaint stub (Member C, Task C-03)
-// Returns 0 without marking; replaced by real validation in C-05.
+// sys_marktaint implementation (Member C, Task C-05)
 uint64
 sys_marktaint(void)
 {
+  char path[MAXPATH];
+  struct inode *ip;
+
+  if (argstr(0, path, MAXPATH) < 0)
+    return -1;
+  if (path[0] == 0)
+    return -1;
+
+  begin_op();
+  if ((ip = namei(path)) == 0) {
+    end_op();
+    return -1;
+  }
+  ilock(ip);
+  if (ip->type != T_FILE) {
+    iunlockput(ip);
+    end_op();
+    return -1;
+  }
+  ip->untrusted = 1;
+  iupdate(ip);
+  iunlockput(ip);
+  end_op();
   return 0;
 }
