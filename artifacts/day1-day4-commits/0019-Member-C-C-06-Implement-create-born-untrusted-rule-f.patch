From f6a56288b0a23d52a73ddac9f4c30a3a2988f724 Mon Sep 17 00:00:00 2001
From: Anshika <anshikabvbvpn0822@gmail.com>
Date: Mon, 26 Oct 2026 22:31:48 +0530
Subject: [PATCH 19/47] [Member C] C-06: Implement create() born-untrusted rule
 for newly allocated inodes

---
 kernel/sysfile.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/kernel/sysfile.c b/kernel/sysfile.c
index c5f8227..c1be2a8 100644
--- a/kernel/sysfile.c
+++ b/kernel/sysfile.c
@@ -295,6 +295,9 @@ create(char *path, short type, short major, short minor)
   ip->major = major;
   ip->minor = minor;
   ip->nlink = 1;
+  if (myproc()->tainted) {
+    ip->untrusted = 1;
+  }
   iupdate(ip);
 
   if (type == T_DIR) { // Create . and .. entries.
