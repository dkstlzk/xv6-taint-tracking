From 7edd646e269eb82981dbb89a1d8abb682b033767 Mon Sep 17 00:00:00 2001
From: Anshika <anshikabvbvpn0822@gmail.com>
Date: Mon, 26 Oct 2026 22:33:40 +0530
Subject: [PATCH 30/47] [Member C] C-07: Implement sys_open write gate before
 itrunc logging write refusal for tainted processes

---
 kernel/sysfile.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/kernel/sysfile.c b/kernel/sysfile.c
index c1be2a8..321727c 100644
--- a/kernel/sysfile.c
+++ b/kernel/sysfile.c
@@ -368,6 +368,15 @@ sys_open(void)
     return -1;
   }
 
+  // Task C-07: sys_open write gate (must precede itrunc)
+  if (myproc()->tainted && ip->type == T_FILE && !ip->untrusted &&
+      (omode & (O_WRONLY | O_RDWR | O_TRUNC))) {
+    iunlockput(ip);
+    end_op();
+    printk("taint: write refused for pid %d\n", myproc()->pid);
+    return -1;
+  }
+
   if ((f = filealloc()) == 0 || (fd = fdalloc(f)) < 0) {
     if (f)
       fileclose(f);
-- 
2.48.1

