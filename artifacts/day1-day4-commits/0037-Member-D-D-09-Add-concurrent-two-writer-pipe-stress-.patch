Subject: [PATCH 37/47] [Member D] D-09: Add concurrent two-writer pipe stress
 test to ptest.c

---
 user/ptest.c | 61 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/user/ptest.c b/user/ptest.c
index db39b09..e6e8b5f 100644
--- a/user/ptest.c
+++ b/user/ptest.c
@@ -239,6 +239,66 @@ test_t20_exec_dir_self_match_refused(void)
   wait(&s);
 }
 
+
+// D-09: Stress test two writers + reader
+void
+test_d09_stress_pipe_concurrency(void)
+{
+  int p[2];
+  pipe(p);
+
+  int pid1 = fork();
+  if (pid1 == 0) {
+    // Writer 1 (clean)
+    for (int i = 0; i < 50; i++) {
+      write(p[1], "C", 1);
+    }
+    close(p[1]);
+    exit(0);
+  }
+
+  int pid2 = fork();
+  if (pid2 == 0) {
+    // Writer 2 (tainted)
+    int fd = open("/untrusted_stress.txt", O_CREATE | O_WRONLY);
+    write(fd, "bad", 3);
+    close(fd);
+    marktaint("/untrusted_stress.txt");
+    fd = open("/untrusted_stress.txt", O_RDONLY);
+    char b[4];
+    read(fd, b, 3);
+    close(fd);
+
+    for (int i = 0; i < 50; i++) {
+      write(p[1], "T", 1);
+    }
+    close(p[1]);
+    exit(0);
+  }
+
+  close(p[1]);
+  int s;
+  wait(&s);
+  wait(&s);
+
+  int rpid = fork();
+  if (rpid == 0) {
+    char buf[128];
+    int total = 0;
+    while (1) {
+      int n = read(p[0], buf, sizeof(buf));
+      if (n <= 0) break;
+      total += n;
+    }
+    close(p[0]);
+    // Reader has consumed tainted bytes -> must be tainted (zero false negatives)
+    exit(istainted() == 1 ? 0 : 1);
+  }
+  wait(&s);
+  close(p[0]);
+  CHECK("D-09", "concurrent pipe stress test: zero false negatives", s == 0);
+}
+
 int
 main(int argc, char *argv[])
 {
@@ -249,6 +309,7 @@ main(int argc, char *argv[])
   run_in_child(test_t10_exec_containment);
   run_in_child(test_t12_taint_survives_exec);
   run_in_child(test_t20_exec_dir_self_match_refused);
+  run_in_child(test_d09_stress_pipe_concurrency);
   tlib_summary();
   exit(0);
 }
