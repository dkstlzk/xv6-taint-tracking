From cdc139a011467c5f9788a4387b9e1f6aa1125917 Mon Sep 17 00:00:00 2001
From: Anshika <anshikabvbvpn0822@gmail.com>
Date: Mon, 26 Oct 2026 22:29:13 +0530
Subject: [PATCH 09/47] [Member B] B-03: Add syscall plumbing for sys_hello,
 sys_istainted, sys_marktaint, and user utilities

---
 kernel/syscall.c |  6 ++++++
 kernel/syscall.h |  3 +++
 kernel/sysproc.c | 18 ++++++++++++++++++
 user/hello.c     | 11 +++++++++++
 user/mark.c      | 17 +++++++++++++++++
 user/user.h      |  3 +++
 user/usys.pl     |  3 +++
 7 files changed, 61 insertions(+)
 create mode 100644 user/hello.c
 create mode 100644 user/mark.c

diff --git a/kernel/syscall.c b/kernel/syscall.c
index 1800f20..35c0813 100644
--- a/kernel/syscall.c
+++ b/kernel/syscall.c
@@ -103,6 +103,9 @@ extern uint64 sys_link(void);
 extern uint64 sys_mkdir(void);
 extern uint64 sys_close(void);
 extern uint64 sys_sync(void);
+extern uint64 sys_marktaint(void);
+extern uint64 sys_istainted(void);
+extern uint64 sys_hello(void);
 
 // An array mapping syscall numbers from syscall.h
 // to the function that handles the system call.
@@ -130,6 +133,9 @@ static uint64 (*syscalls[])(void) = {
   [SYS_mkdir]   = sys_mkdir,
   [SYS_close]   = sys_close,
   [SYS_sync]    = sys_sync,
+  [SYS_marktaint] = sys_marktaint,
+  [SYS_istainted] = sys_istainted,
+  [SYS_hello]     = sys_hello,
   // clang-format on
 };
 
diff --git a/kernel/syscall.h b/kernel/syscall.h
index 5a4a39f..039fd25 100644
--- a/kernel/syscall.h
+++ b/kernel/syscall.h
@@ -21,3 +21,6 @@
 #define SYS_mkdir  20
 #define SYS_close  21
 #define SYS_sync   22
+#define SYS_marktaint  23
+#define SYS_istainted  24
+#define SYS_hello      25
diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index cd25557..6a7ce87 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -110,3 +110,21 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+uint64
+sys_istainted(void)
+{
+  return myproc()->tainted;
+}
+
+uint64
+sys_hello(void)
+{
+  int a, b, c, d;
+  argint(0, &a);
+  argint(1, &b);
+  argint(2, &c);
+  argint(3, &d);
+  printk("hello %d %d %d %d\n", a, b, c, d);
+  return (uint64)(a + b + c + d);
+}
diff --git a/user/hello.c b/user/hello.c
new file mode 100644
index 0000000..0fbd66a
--- /dev/null
+++ b/user/hello.c
@@ -0,0 +1,11 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  int sum = hello(1, 2, 3, 4);
+  printf("sum = %d\n", sum);
+  exit(0);
+}
diff --git a/user/mark.c b/user/mark.c
new file mode 100644
index 0000000..1ccd3b3
--- /dev/null
+++ b/user/mark.c
@@ -0,0 +1,17 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc < 2) {
+    fprintf(2, "Usage: mark <path>\n");
+    exit(1);
+  }
+  if (marktaint(argv[1]) < 0) {
+    fprintf(2, "mark: failed to mark %s\n", argv[1]);
+    exit(1);
+  }
+  exit(0);
+}
diff --git a/user/user.h b/user/user.h
index 29aad59..5eb81ff 100644
--- a/user/user.h
+++ b/user/user.h
@@ -25,6 +25,9 @@ char *sys_sbrk(int, int);
 int pause(int);
 int uptime(void);
 int sync(void);
+int marktaint(char*);
+int istainted(void);
+int hello(int, int, int, int);
 
 // ulib.c
 int stat(const char *, struct stat *);
diff --git a/user/usys.pl b/user/usys.pl
index 4d054e8..af6f02b 100755
--- a/user/usys.pl
+++ b/user/usys.pl
@@ -43,3 +43,6 @@ entry("sbrk");
 entry("pause");
 entry("uptime");
 entry("sync");
+entry("marktaint");
+entry("istainted");
+entry("hello");
-- 
2.48.1

