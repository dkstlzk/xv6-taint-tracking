From: Anshika <anshikabvbvpn0822@gmail.com>
Date: Mon, 26 Oct 2026 22:32:55 +0530
Subject: [PATCH 26/47] [Member A] A-07: Add persistent-disk and fresh-disk
 modes with SHA-256 image checksum verification

---
 agent_lab/xv6agent/bridge.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/agent_lab/xv6agent/bridge.py b/agent_lab/xv6agent/bridge.py
index c7be04e..b74ead0 100644
--- a/agent_lab/xv6agent/bridge.py
+++ b/agent_lab/xv6agent/bridge.py
@@ -56,6 +56,16 @@ class QemuBridge:
             "kernel_logs": []
         }
 
+
+    def get_disk_checksum(self):
+        import hashlib
+        if not os.path.exists(self.disk_path):
+            return "NO_DISK"
+        h = hashlib.sha256()
+        with open(self.disk_path, "rb") as f:
+            while chunk := f.read(8192):
+                h.update(chunk)
+        return h.hexdigest()
     def restart(self):
         self.stop()
         self.start()
