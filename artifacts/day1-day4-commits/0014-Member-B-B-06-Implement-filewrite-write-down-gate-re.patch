From d80193740d631b54ba8d5e43d08d087587dd5a90 Mon Sep 17 00:00:00 2001
From: Anshika <anshikabvbvpn0822@gmail.com>
Date: Mon, 26 Oct 2026 22:30:29 +0530
Subject: [PATCH 14/47] [Member B] B-06: Implement filewrite write-down gate
 refusing tainted writes to clean files

---
 kernel/file.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/kernel/file.c b/kernel/file.c
index 750085f..0da4fb5 100644
--- a/kernel/file.c
+++ b/kernel/file.c
@@ -163,6 +163,12 @@ filewrite(struct file *f, uint64 addr, int n)
 
       begin_op();
       ilock(f->ip);
+      if (myproc()->tainted && f->ip->type == T_FILE && !f->ip->untrusted) {
+        iunlock(f->ip);
+        end_op();
+        printk("taint: write refused for pid %d\n", myproc()->pid);
+        return -1;
+      }
       if ((r = writei(f->ip, 1, addr + i, f->off, n1)) > 0)
         f->off += r;
       iunlock(f->ip);
-- 
