From 090f61b18e4b3964a96cf99294ee5cbb4f2007ca Mon Sep 17 00:00:00 2001
From: Anshika <anshikabvbvpn0822@gmail.com>
Date: Mon, 26 Oct 2026 22:33:55 +0530
Subject: [PATCH 31/47] [Member C] C-08: Implement sys_unlink and sys_link
 refusals with canonical logging for tainted callers

---
 kernel/sysfile.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/kernel/sysfile.c b/kernel/sysfile.c
index 321727c..577c81a 100644
--- a/kernel/sysfile.c
+++ b/kernel/sysfile.c
@@ -126,6 +126,11 @@ sys_link(void)
   char name[DIRSIZ], new[MAXPATH], old[MAXPATH];
   struct inode *dp, *ip;
 
+  if (myproc()->tainted) {
+    printk("taint: link refused for pid %d\n", myproc()->pid);
+    return -1;
+  }
+
   if (argstr(0, old, MAXPATH) < 0 || argstr(1, new, MAXPATH) < 0)
     return -1;
 
@@ -206,6 +211,11 @@ sys_unlink(void)
   char name[DIRSIZ], path[MAXPATH];
   uint off;
 
+  if (myproc()->tainted) {
+    printk("taint: unlink refused for pid %d\n", myproc()->pid);
+    return -1;
+  }
+
   if (argstr(0, path, MAXPATH) < 0)
     return -1;
 
-- 
