From f05422d541b7b03c8b6af58a330c9481df4b25fb Mon Sep 17 00:00:00 2001
From: Anshika <anshikabvbvpn0822@gmail.com>
Date: Mon, 26 Oct 2026 22:34:42 +0530
Subject: [PATCH 34/47] [Member D] D-05: Implement pre-lock in_safe and
 post-lock untrusted exec containment in exec.c

---
 kernel/exec.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/kernel/exec.c b/kernel/exec.c
index 8c9673f..067a49a 100644
--- a/kernel/exec.c
+++ b/kernel/exec.c
@@ -6,6 +6,10 @@
 #include "proc.h"
 #include "defs.h"
 #include "elf.h"
+#include "stat.h"
+#include "sleeplock.h"
+#include "fs.h"
+#include "file.h"
 
 static int loadseg(pde_t *, uint64, struct inode *, uint, uint);
 
@@ -43,8 +47,25 @@ kexec(char *path, char **argv)
     end_op();
     return -1;
   }
+
+  // Task D-05: pre-lock in_safe check
+  if (p->tainted && !in_safe(ip)) {
+    iput(ip);
+    end_op();
+    printk("taint: exec refused for pid %d\n", p->pid);
+    return -1;
+  }
+
   ilock(ip);
 
+  // Task D-05: post-lock type and untrusted checks
+  if (p->tainted && (ip->type != T_FILE || ip_untrusted(ip))) {
+    iunlockput(ip);
+    end_op();
+    printk("taint: exec refused for pid %d\n", p->pid);
+    return -1;
+  }
+
   // Read the ELF header.
   if (readi(ip, 0, (uint64)&elf, 0, sizeof(elf)) != sizeof(elf))
     goto bad;
-- 
